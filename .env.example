# FilesFlix Configuration
# Copy this file to .env and update the values

# Security Settings
SECRET_KEY=your-secret-key-here-change-in-production
HOST_USERNAME=admin
HOST_PASSWORD=password123

# Server Settings
HOST=0.0.0.0
PORT=5000

# FFmpeg Paths (optional - leave empty if in PATH)
FFMPEG_PATH=
FFPROBE_PATH=

# Media Directory (optional - defaults to current directory)
MEDIA_DIRECTORY=